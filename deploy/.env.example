# Copy to deploy/.env.local and edit. Loaded by the Mac-side deploy/logs/ssh scripts.
# deploy/.env.local is gitignored.

# Tailscale hostname (or LAN hostname / IP) of the Pi.
PI_HOST=solarpi

# Username on the Pi.
PI_USER=scott

# Path to the repo on the Pi.
PI_REPO=/home/scott/solarcontrol

# systemd service name.
SERVICE_NAME=solarcontrol

# Grafana, for `make dashboard-pull` (export live dashboard JSON to the repo).
# URL reachable from the Mac (Tailscale name works).
GRAFANA_URL=http://raspberrypi:3000
# Service account token: in Grafana -> Administration -> Users and access ->
# Service accounts -> Add service account (role: Editor) -> Add token.
GRAFANA_TOKEN=
